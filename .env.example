# Vercel Functions — utilisé par api/assistant.js et api/relais.js.
# Ne préfixez jamais une clé secrète par VITE_ : elle serait exposée au navigateur.
ANTHROPIC_API_KEY=
ASSISTANT_MODELE=claude-sonnet-5
ASSISTANT_MODELE_DIFFICILE=claude-opus-4-8
APP_ORIGIN=http://localhost:5173
AGENCE_EMAILS=prenom.nom@example.com

# Vérification du JWT Supabase par la fonction assistant. Définissez la clé
# publishable moderne ou, pour un ancien projet, la clé anon (fallback).
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=

# Supabase Edge Functions et scraper-worker — secrets strictement serveur.
# SUPABASE_URL est injectée automatiquement dans les Edge Functions déployées.
# SUPABASE_SERVICE_ROLE_KEY ne doit jamais être copiée dans l'interface ni dans du code client.
SUPABASE_SERVICE_ROLE_KEY=
# Optionnel pour signer les liens d’initiation Gmail (32 caractères minimum).
# À définir avec `supabase secrets set`, jamais comme variable VITE_*.
# Sans cette valeur, les Edge Functions utilisent la service-role déjà injectée.
GMAIL_OAUTH_INIT_SECRET=

# La Project URL et la clé anon/publishable du navigateur se configurent dans
# Paramètres > Synchronisation ; le code ne lit pas de VITE_SUPABASE_*.
